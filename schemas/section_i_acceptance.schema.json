{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Implements spec §4 §I. Operational examples are curated guidance, not an automated quota or score gate.",
  "type": "object",
  "required": [
    "scenario_set"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario_set": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "refs",
          "scenario",
          "expected_answers"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I-\\d{2,}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "operate",
              "isolate",
              "repair",
              "evolve",
              "ambiguous"
            ]
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "scenario": {
            "type": "string",
            "minLength": 10
          },
          "expected_answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "tool_call",
                    "human_action",
                    "classification"
                  ]
                },
                "tool": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "argument_keys": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "argument_values": {
                  "type": "object"
                },
                "verb": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "object": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "target": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": true,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "tool_call"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "tool",
                      "argument_keys"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "human_action"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "verb",
                      "object",
                      "target"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "classification"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "label"
                    ]
                  }
                }
              ]
            }
          },
          "weight": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    }
  }
}
