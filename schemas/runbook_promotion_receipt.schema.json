{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.market/schemas/runbook-promotion-receipt-v1.json",
  "$comment": "Future server-issued receipt contract. This schema contains no trust keys or pins; admission additionally requires signature, issuer, revocation, freshness, evidence-resolution, source-binding, and reviewer-independence verification by the deployed authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "receipt_id",
    "issuer",
    "issued_at",
    "expires_at",
    "subject",
    "material_claims",
    "verified_against",
    "independent_review",
    "signature"
  ],
  "properties": {
    "contract_version": {
      "const": "ai.market/runbook-promotion-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^runbook-promotion:[A-Za-z0-9._:-]{1,200}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "runbook_id",
        "source_sha256",
        "risk",
        "author_principal"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "runbook_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "risk": {"enum": ["P0", "P1", "P2", "P3"]},
        "author_principal": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "material_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "section", "claim_sha256", "evidence_ids"],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "section": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"]},
          "claim_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "verified_against": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "locator", "digest_sha256", "observed_at"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "repository_blob",
              "deployed_contract",
              "configuration_revision",
              "database_schema",
              "live_probe_receipt",
              "build_receipt",
              "action_receipt"
            ]
          },
          "locator": {"type": "string", "format": "uri", "maxLength": 2048},
          "digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_receipt_id",
        "reviewer_principal",
        "reviewed_source_sha256",
        "reviewed_at",
        "verdict"
      ],
      "properties": {
        "review_receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "reviewer_principal": {"type": "string", "minLength": 1, "maxLength": 256},
        "reviewed_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "verdict": {"const": "approved"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "key_id", "value_base64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "canonicalization": {"const": "RFC8785"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "value_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "maxLength": 256
        }
      }
    }
  }
}
