{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.market/schemas/runbook-promotion-evidence-v1.json",
  "$comment": "Preparatory author-visible claim/evidence projection only. Blob identity and section mapping do not prove semantic support and cannot authorize promotion. The corpus manifest may supply an exact inventory commit, but this document never supplies claim-bound verification, a trust root, or independent review authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "risk",
    "section_coverage",
    "verified_against"
  ],
  "properties": {
    "contract_version": {
      "const": "ai.market/runbook-promotion-evidence/v1"
    },
    "risk": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "section_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "status", "evidence_ids"],
            "properties": {
              "section": {
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"]
              },
              "status": {
                "const": "VERIFIED"
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "status", "gap"],
            "properties": {
              "section": {
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"]
              },
              "status": {
                "const": "UNKNOWN"
              },
              "gap": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gap_id", "reason", "tracking_ref"],
                "properties": {
                  "gap_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 500
                  },
                  "tracking_ref": {
                    "type": "string",
                    "pattern": "^(?:ticket|event|git):\\S+$"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "verified_against": {
      "description": "Preparatory candidate locators. Despite the legacy field name, these rows are not verified authority until a trusted server receipt binds exact claims to independently reviewed evidence.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "artifact_type",
          "locator",
          "git_blob_oid",
          "content_sha256",
          "supports_sections"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "const": "repository_blob"
          },
          "artifact_type": {
            "enum": ["code", "test", "schema", "spec", "workflow"]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "git_blob_oid": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "supports_sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "uniqueItems": true,
            "items": {
              "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"]
            }
          }
        }
      }
    },
    "server_receipt_id": {
      "type": "string",
      "pattern": "^runbook-promotion:[A-Za-z0-9._:-]{1,200}$"
    }
  }
}
