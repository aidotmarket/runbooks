{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.market/schemas/deployed-tool-contract/v3",
  "title": "Signed deployed gateway tool and Council contract",
  "type": "object",
  "required": ["artifact", "signature", "signature_metadata"],
  "additionalProperties": false,
  "properties": {
    "artifact": {"$ref": "#/$defs/artifact"},
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "signature_metadata": {"$ref": "#/$defs/signatureMetadata"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueMemberList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "sourceIdentifier": {
      "type": "object",
      "required": [
        "projection",
        "repository",
        "commit_sha",
        "path",
        "symbol",
        "blob_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "projection": {
          "enum": [
            "tools",
            "council.required_members",
            "council.valid_member_ids",
            "council.hall.valid_agents",
            "council.hall.default_agents",
            "council.current_roles",
            "runbook_lifecycle",
            "action_registry",
            "source_fetch",
            "runtime_lock",
            "cutover",
            "proxy"
          ]
        },
        "repository": {"$ref": "#/$defs/nonEmptyString"},
        "commit_sha": {"$ref": "#/$defs/gitSha"},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "symbol": {"$ref": "#/$defs/nonEmptyString"},
        "blob_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "objectJsonSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": ["value", "effect", "risk", "receipt_requirement"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/nonEmptyString"},
        "effect": {"enum": ["read_only", "mutating"]},
        "risk": {"enum": ["none", "low", "medium", "high"]},
        "receipt_requirement": {"enum": ["none", "exact_arguments"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"effect": {"const": "read_only"}},
            "required": ["effect"]
          },
          "then": {
            "properties": {
              "risk": {"const": "none"},
              "receipt_requirement": {"const": "none"}
            }
          }
        },
        {
          "if": {
            "properties": {"effect": {"const": "mutating"}},
            "required": ["effect"]
          },
          "then": {
            "properties": {"risk": {"enum": ["low", "medium", "high"]}}
          }
        }
      ]
    },
    "toolEffect": {
      "type": "object",
      "required": [
        "mode",
        "default_effect",
        "default_risk",
        "default_receipt_requirement",
        "action_discriminator",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["read_only", "mutating", "action_discriminated"]},
        "default_effect": {"enum": ["read_only", "mutating"]},
        "default_risk": {"enum": ["none", "low", "medium", "high"]},
        "default_receipt_requirement": {"enum": ["none", "exact_arguments"]},
        "action_discriminator": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/actionEffect"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "read_only"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "read_only"},
              "default_risk": {"const": "none"},
              "default_receipt_requirement": {"const": "none"},
              "action_discriminator": {"const": null},
              "actions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "mutating"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "mutating"},
              "default_risk": {"enum": ["low", "medium", "high"]},
              "action_discriminator": {"const": null},
              "actions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "action_discriminated"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "mutating"},
              "default_risk": {"const": "high"},
              "action_discriminator": {"type": "string", "minLength": 1},
              "actions": {"minItems": 1}
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "title",
        "description",
        "inputSchema",
        "outputSchema",
        "effect",
        "annotations",
        "_meta"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "title": {"type": "string"},
        "description": {"type": "string"},
        "inputSchema": {"$ref": "#/$defs/objectJsonSchema"},
        "outputSchema": {"$ref": "#/$defs/objectJsonSchema"},
        "effect": {"$ref": "#/$defs/toolEffect"},
        "annotations": {"type": "object"},
        "_meta": {"type": "object"}
      }
    },
    "planLifecycle": {
      "type": "object",
      "required": [
        "tool_name",
        "protocol",
        "first_outcome_discriminator",
        "selection_required_outcome",
        "accepted_outcome",
        "first_outcome_typed",
        "first_outcome_semantic_writes",
        "binding",
        "selection_envelope_property",
        "accepted_receipt_property",
        "context_property",
        "automatic_child_context",
        "obligation_subjects",
        "exact_source_fetch"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "protocol": {"const": "server_delivered_one_call"},
        "first_outcome_discriminator": {"$ref": "#/$defs/nonEmptyString"},
        "selection_required_outcome": {"const": "NONE"},
        "accepted_outcome": {"const": "PLAN_ACCEPTED"},
        "first_outcome_typed": {"const": true},
        "first_outcome_semantic_writes": {"const": "atomic_after_delivery"},
        "binding": {"const": "server_bound_session_instance_revision_request_activation_objectives_obligations_context_digest"},
        "selection_envelope_property": {"const": "NONE"},
        "accepted_receipt_property": {"const": "accepted_plan_receipt"},
        "context_property": {"const": "runbook_context"},
        "automatic_child_context": {"const": true},
        "obligation_subjects": {"const": "backend_cursor_complete"},
        "exact_source_fetch": {"const": "section_and_full_runbook_cursor"}
      }
    },
    "lifecycleDelivery": {
      "type": "object",
      "required": [
        "candidate_delivery_mode",
        "legacy_consultation_mode",
        "candidate_limit",
        "active_guidance_mode",
        "discovery_guidance_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_delivery_mode": {"enum": ["off", "shadow", "assist", "required"]},
        "legacy_consultation_mode": {"const": "absent"},
        "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 4},
        "active_guidance_mode": {"const": "integrity_verified_advisory"},
        "discovery_guidance_mode": {"const": "labeled_advisory_nonblocking"}
      }
    },
    "closeLifecycle": {
      "type": "object",
      "required": [
        "tool_name",
        "protocol",
        "outcome_discriminator",
        "committed_outcome",
        "receipt",
        "committed_receipt_property",
        "obligation_outcomes_property",
        "obligation_transaction",
        "server_owned_evidence",
        "caller_runbook_fields",
        "semantic_uncertainty",
        "next_action_enforcement"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "protocol": {"const": "backend_evidence_atomic_close"},
        "outcome_discriminator": {"$ref": "#/$defs/nonEmptyString"},
        "committed_outcome": {"enum": ["NONE", "COMMITTED"]},
        "receipt": {"enum": ["none", "typed_transaction_scoped_committed"]},
        "committed_receipt_property": {"enum": ["NONE", "close_receipt"]},
        "obligation_outcomes_property": {"enum": ["NONE", "obligation_outcomes"]},
        "obligation_transaction": {"enum": ["none", "atomic_backend_transaction_outbox"]},
        "server_owned_evidence": {"const": true},
        "caller_runbook_fields": {"const": "absent"},
        "semantic_uncertainty": {"const": "commit_with_open_obligation"},
        "next_action_enforcement": {"const": "component_behavior_change_only"}
      }
    },
    "actionEvidence": {
      "type": "object",
      "required": [
        "protocol",
        "context_required_outcome",
        "outcome_discriminator",
        "receipt_argument",
        "context_property",
        "context_outcome_typed",
        "context_outcome_semantic_writes",
        "one_use",
        "expiring",
        "binding"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {"const": "backend_intent_and_terminal_observation"},
        "context_required_outcome": {"const": "NONE"},
        "outcome_discriminator": {"enum": ["outcome"]},
        "receipt_argument": {"const": "NONE"},
        "context_property": {"const": "NONE"},
        "context_outcome_typed": {"const": false},
        "context_outcome_semantic_writes": {"const": "backend_transaction"},
        "one_use": {"const": true},
        "expiring": {"const": true},
        "binding": {"const": "session_actor_handler_canonical_arguments_component_policy_action_remote_candidate"}
      }
    },
    "cutover": {
      "type": "object",
      "required": [
        "state",
        "activation_receipt_sha256",
        "legacy_runtime_absent",
        "local_authority_absent",
        "fallback_absent",
        "database_freeze_verified",
        "rollback_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {"const": "ACTIVE_ONE_WAY"},
        "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "legacy_runtime_absent": {"const": true},
        "local_authority_absent": {"const": true},
        "fallback_absent": {"const": true},
        "database_freeze_verified": {"const": true},
        "rollback_mode": {"const": "new_path_only"}
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "required": [
        "verifier_tree_sha256",
        "artifact_manifest_sha256",
        "dependency_lock_sha256",
        "python_runtime_sha256",
        "module_origins_sha256",
        "workflow_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "verifier_tree_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "python_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "module_origins_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runbookLifecycle": {
      "type": "object",
      "required": ["profile", "plan", "delivery", "close", "action_evidence", "cutover"],
      "additionalProperties": false,
      "properties": {
        "profile": {"const": "runbook_first_v2"},
        "plan": {"$ref": "#/$defs/planLifecycle"},
        "delivery": {"$ref": "#/$defs/lifecycleDelivery"},
        "close": {"$ref": "#/$defs/closeLifecycle"},
        "action_evidence": {"$ref": "#/$defs/actionEvidence"},
        "cutover": {"$ref": "#/$defs/cutover"}
      }
    },
    "roleProjection": {
      "type": "object",
      "required": ["builders", "voters", "paused", "retired"],
      "additionalProperties": false,
      "properties": {
        "builders": {"$ref": "#/$defs/uniqueMemberList"},
        "voters": {
          "allOf": [
            {"$ref": "#/$defs/uniqueMemberList"},
            {"minItems": 1}
          ]
        },
        "paused": {"$ref": "#/$defs/uniqueMemberList"},
        "retired": {"$ref": "#/$defs/uniqueMemberList"}
      }
    },
    "hall": {
      "type": "object",
      "required": [
        "tool_name",
        "agents_argument",
        "valid_agents",
        "default_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "agents_argument": {"$ref": "#/$defs/nonEmptyString"},
        "valid_agents": {"$ref": "#/$defs/uniqueMemberList"},
        "default_agents": {"$ref": "#/$defs/uniqueMemberList"}
      }
    },
    "council": {
      "type": "object",
      "required": [
        "dispatch_tool_name",
        "member_argument",
        "required_members",
        "valid_member_ids",
        "hall",
        "current_roles"
      ],
      "additionalProperties": false,
      "properties": {
        "dispatch_tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "member_argument": {"$ref": "#/$defs/nonEmptyString"},
        "required_members": {"$ref": "#/$defs/uniqueMemberList"},
        "valid_member_ids": {"$ref": "#/$defs/uniqueMemberList"},
        "hall": {"$ref": "#/$defs/hall"},
        "current_roles": {"$ref": "#/$defs/roleProjection"}
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_format_version",
        "handler_sha",
        "handler_release_identity",
        "proxy_release_identity",
        "policy_revision",
        "schema_digest_sha256",
        "tools",
        "council",
        "runbook_lifecycle",
        "runtime_identity",
        "source_identifiers"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_format_version": {"const": "3"},
        "handler_sha": {"$ref": "#/$defs/gitSha"},
        "handler_release_identity": {"$ref": "#/$defs/nonEmptyString"},
        "proxy_release_identity": {"$ref": "#/$defs/nonEmptyString"},
        "policy_revision": {"$ref": "#/$defs/nonEmptyString"},
        "schema_digest_sha256": {"$ref": "#/$defs/sha256"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/tool"}
        },
        "council": {"$ref": "#/$defs/council"},
        "runbook_lifecycle": {"$ref": "#/$defs/runbookLifecycle"},
        "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
        "source_identifiers": {
          "type": "array",
          "minItems": 12,
          "items": {"$ref": "#/$defs/sourceIdentifier"}
        }
      }
    },
    "signatureMetadata": {
      "type": "object",
      "required": [
        "algorithm",
        "kid",
        "issuer",
        "audience",
        "issued_at",
        "key_valid_from",
        "key_valid_until",
        "artifact_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "issuer": {"$ref": "#/$defs/nonEmptyString"},
        "audience": {"$ref": "#/$defs/nonEmptyString"},
        "issued_at": {"type": "string", "format": "date-time"},
        "key_valid_from": {"type": "string", "format": "date-time"},
        "key_valid_until": {"type": "string", "format": "date-time"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
