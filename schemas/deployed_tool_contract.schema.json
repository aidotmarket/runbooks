{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.market/schemas/deployed-tool-contract/v2",
  "title": "Signed deployed gateway tool and Council contract",
  "type": "object",
  "required": ["artifact", "signature", "signature_metadata"],
  "additionalProperties": false,
  "properties": {
    "artifact": {"$ref": "#/$defs/artifact"},
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "signature_metadata": {"$ref": "#/$defs/signatureMetadata"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueMemberList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "sourceIdentifier": {
      "type": "object",
      "required": [
        "projection",
        "repository",
        "commit_sha",
        "path",
        "symbol",
        "blob_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "projection": {
          "enum": [
            "tools",
            "council.required_members",
            "council.valid_member_ids",
            "council.hall.valid_agents",
            "council.hall.default_agents",
            "council.current_roles",
            "runbook_lifecycle",
            "proxy"
          ]
        },
        "repository": {"$ref": "#/$defs/nonEmptyString"},
        "commit_sha": {"$ref": "#/$defs/gitSha"},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "symbol": {"$ref": "#/$defs/nonEmptyString"},
        "blob_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "objectJsonSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": ["value", "effect", "risk", "receipt_requirement"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/nonEmptyString"},
        "effect": {"enum": ["read_only", "mutating"]},
        "risk": {"enum": ["none", "low", "medium", "high"]},
        "receipt_requirement": {"enum": ["none", "exact_arguments"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"effect": {"const": "read_only"}},
            "required": ["effect"]
          },
          "then": {
            "properties": {
              "risk": {"const": "none"},
              "receipt_requirement": {"const": "none"}
            }
          }
        },
        {
          "if": {
            "properties": {"effect": {"const": "mutating"}},
            "required": ["effect"]
          },
          "then": {
            "properties": {"risk": {"enum": ["low", "medium", "high"]}}
          }
        }
      ]
    },
    "toolEffect": {
      "type": "object",
      "required": [
        "mode",
        "default_effect",
        "default_risk",
        "default_receipt_requirement",
        "action_discriminator",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["read_only", "mutating", "action_discriminated"]},
        "default_effect": {"enum": ["read_only", "mutating"]},
        "default_risk": {"enum": ["none", "low", "medium", "high"]},
        "default_receipt_requirement": {"enum": ["none", "exact_arguments"]},
        "action_discriminator": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/actionEffect"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "read_only"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "read_only"},
              "default_risk": {"const": "none"},
              "default_receipt_requirement": {"const": "none"},
              "action_discriminator": {"const": null},
              "actions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "mutating"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "mutating"},
              "default_risk": {"enum": ["low", "medium", "high"]},
              "action_discriminator": {"const": null},
              "actions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "action_discriminated"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "default_effect": {"const": "mutating"},
              "default_risk": {"const": "high"},
              "action_discriminator": {"type": "string", "minLength": 1},
              "actions": {"minItems": 1}
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "title",
        "description",
        "inputSchema",
        "outputSchema",
        "effect",
        "annotations",
        "_meta"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "title": {"type": "string"},
        "description": {"type": "string"},
        "inputSchema": {"$ref": "#/$defs/objectJsonSchema"},
        "outputSchema": {"$ref": "#/$defs/objectJsonSchema"},
        "effect": {"$ref": "#/$defs/toolEffect"},
        "annotations": {"type": "object"},
        "_meta": {"type": "object"}
      }
    },
    "planLifecycle": {
      "type": "object",
      "required": [
        "tool_name",
        "protocol",
        "first_outcome_discriminator",
        "selection_required_outcome",
        "accepted_outcome",
        "first_outcome_typed",
        "first_outcome_semantic_writes",
        "binding",
        "selection_envelope_property",
        "accepted_receipt_property"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "protocol": {"enum": ["legacy_caller_authored", "server_delivered_two_stage"]},
        "first_outcome_discriminator": {"$ref": "#/$defs/nonEmptyString"},
        "selection_required_outcome": {"enum": ["NONE", "RUNBOOK_CONTEXT_SELECTION_REQUIRED"]},
        "accepted_outcome": {"enum": ["NONE", "PLAN_ACCEPTED"]},
        "first_outcome_typed": {"type": "boolean"},
        "first_outcome_semantic_writes": {"enum": ["not_applicable", "none", "possible"]},
        "binding": {
          "enum": [
            "caller_authored_refs",
            "server_issued_ids_bound_to_session_instance_objectives_work_type_revision_catalog_excerpt_digest"
          ]
        },
        "selection_envelope_property": {"enum": ["NONE", "selection_set"]},
        "accepted_receipt_property": {"enum": ["NONE", "accepted_plan_receipt"]}
      }
    },
    "lifecycleDelivery": {
      "type": "object",
      "required": [
        "candidate_delivery_mode",
        "legacy_consultation_mode",
        "candidate_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_delivery_mode": {"enum": ["off", "shadow", "assist", "required"]},
        "legacy_consultation_mode": {"enum": ["allow", "warn", "reject"]},
        "candidate_limit": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "closeLifecycle": {
      "type": "object",
      "required": [
        "tool_name",
        "protocol",
        "outcome_discriminator",
        "committed_outcome",
        "receipt",
        "committed_receipt_property",
        "obligation_outcomes_property",
        "obligation_transaction",
        "server_owned_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "protocol": {"enum": ["legacy_runbook_exit", "structured_runbook_impact"]},
        "outcome_discriminator": {"$ref": "#/$defs/nonEmptyString"},
        "committed_outcome": {"enum": ["NONE", "COMMITTED"]},
        "receipt": {"enum": ["none", "typed_transaction_scoped_committed"]},
        "committed_receipt_property": {"enum": ["NONE", "close_receipt"]},
        "obligation_outcomes_property": {"enum": ["NONE", "obligation_outcomes"]},
        "obligation_transaction": {"enum": ["none", "atomic_backend_transaction_outbox"]},
        "server_owned_evidence": {"type": "boolean"}
      }
    },
    "actionReceipts": {
      "type": "object",
      "required": [
        "protocol",
        "context_required_outcome",
        "outcome_discriminator",
        "receipt_argument",
        "context_property",
        "context_outcome_typed",
        "context_outcome_semantic_writes",
        "one_use",
        "expiring",
        "binding"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {"enum": ["none", "two_stage_exact_arguments"]},
        "context_required_outcome": {"enum": ["NONE", "ACTION_CONTEXT_REQUIRED"]},
        "outcome_discriminator": {"enum": ["outcome"]},
        "receipt_argument": {"enum": ["NONE", "action_receipt"]},
        "context_property": {"enum": ["NONE", "action_context"]},
        "context_outcome_typed": {"type": "boolean"},
        "context_outcome_semantic_writes": {"enum": ["not_applicable", "none", "possible"]},
        "one_use": {"type": "boolean"},
        "expiring": {"type": "boolean"},
        "binding": {"enum": ["none", "canonical_tool_arguments_session_component_policy_revision"]}
      }
    },
    "runbookLifecycle": {
      "type": "object",
      "required": ["profile", "plan", "delivery", "close", "action_receipts"],
      "additionalProperties": false,
      "properties": {
        "profile": {"enum": ["legacy", "target"]},
        "plan": {"$ref": "#/$defs/planLifecycle"},
        "delivery": {"$ref": "#/$defs/lifecycleDelivery"},
        "close": {"$ref": "#/$defs/closeLifecycle"},
        "action_receipts": {"$ref": "#/$defs/actionReceipts"}
      }
    },
    "roleProjection": {
      "type": "object",
      "required": ["builders", "voters", "paused", "retired"],
      "additionalProperties": false,
      "properties": {
        "builders": {"$ref": "#/$defs/uniqueMemberList"},
        "voters": {
          "allOf": [
            {"$ref": "#/$defs/uniqueMemberList"},
            {"minItems": 1}
          ]
        },
        "paused": {"$ref": "#/$defs/uniqueMemberList"},
        "retired": {"$ref": "#/$defs/uniqueMemberList"}
      }
    },
    "hall": {
      "type": "object",
      "required": [
        "tool_name",
        "agents_argument",
        "valid_agents",
        "default_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "agents_argument": {"$ref": "#/$defs/nonEmptyString"},
        "valid_agents": {"$ref": "#/$defs/uniqueMemberList"},
        "default_agents": {"$ref": "#/$defs/uniqueMemberList"}
      }
    },
    "council": {
      "type": "object",
      "required": [
        "dispatch_tool_name",
        "member_argument",
        "required_members",
        "valid_member_ids",
        "hall",
        "current_roles"
      ],
      "additionalProperties": false,
      "properties": {
        "dispatch_tool_name": {"$ref": "#/$defs/nonEmptyString"},
        "member_argument": {"$ref": "#/$defs/nonEmptyString"},
        "required_members": {"$ref": "#/$defs/uniqueMemberList"},
        "valid_member_ids": {"$ref": "#/$defs/uniqueMemberList"},
        "hall": {"$ref": "#/$defs/hall"},
        "current_roles": {"$ref": "#/$defs/roleProjection"}
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_format_version",
        "handler_sha",
        "handler_release_identity",
        "proxy_release_identity",
        "policy_revision",
        "schema_digest_sha256",
        "tools",
        "council",
        "runbook_lifecycle",
        "source_identifiers"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_format_version": {"const": "2"},
        "handler_sha": {"$ref": "#/$defs/gitSha"},
        "handler_release_identity": {"$ref": "#/$defs/nonEmptyString"},
        "proxy_release_identity": {"$ref": "#/$defs/nonEmptyString"},
        "policy_revision": {"$ref": "#/$defs/nonEmptyString"},
        "schema_digest_sha256": {"$ref": "#/$defs/sha256"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/tool"}
        },
        "council": {"$ref": "#/$defs/council"},
        "runbook_lifecycle": {"$ref": "#/$defs/runbookLifecycle"},
        "source_identifiers": {
          "type": "array",
          "minItems": 8,
          "items": {"$ref": "#/$defs/sourceIdentifier"}
        }
      }
    },
    "signatureMetadata": {
      "type": "object",
      "required": [
        "algorithm",
        "kid",
        "issuer",
        "audience",
        "issued_at",
        "key_valid_from",
        "key_valid_until",
        "artifact_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "issuer": {"$ref": "#/$defs/nonEmptyString"},
        "audience": {"$ref": "#/$defs/nonEmptyString"},
        "issued_at": {"type": "string", "format": "date-time"},
        "key_valid_from": {"type": "string", "format": "date-time"},
        "key_valid_until": {"type": "string", "format": "date-time"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
