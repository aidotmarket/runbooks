#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
    python=python3
else
    python=python
fi

"$python" scripts/check.py
"$python" scripts/index.py

if ! git diff --quiet -- INDEX.md ERRORS.md; then
    printf '%s\n' 'INDEX.md or ERRORS.md was stale; review and stage the regenerated files.' >&2
    exit 1
fi
